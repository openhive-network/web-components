{
  "name": "@hiveio/component-internal",
  "version": "1.0.0",
  "description": "Internal utilities for Hive components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "jq --slurpfile source ../../package.json '.version = $source[0].version | .publishConfig.registry = $source[0].publishConfig.registry | .publishConfig.tag = $source[0].publishConfig.tag' package.json > package.json.tmp && mv package.json.tmp package.json"
  },
  "dependencies": {
    "@hiveio/content-renderer": "^2.3.1",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": null,
    "tag": null
  }
}
